# ==============================================================================
# MCP-Sentinel — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Populate the required variables (DATABASE_URL, GEMINI_API_KEY, JWT_SECRET_KEY)
# 3. NEVER commit your actual .env file or real secrets to source control.
# ==============================================================================

# ==============================================================================
# 1. Application & Server
# ==============================================================================
# Runtime environment: development | staging | production | test
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Server metadata
MCP_SERVER_NAME=MCP-Sentinel
MCP_SERVER_VERSION=1.0.0-rc.1

# Exposed port bindings (Docker Compose & Local)
API_PORT=8000
WEB_PORT=3000

# Public web console API gateway URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# 2. Database (PostgreSQL / Supabase) & Connection Pooling
# ==============================================================================
# PostgreSQL Connection URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/mcp_sentinel_db

# Optional Supabase direct / pooler connection configuration
SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_PROJECT_REF=your_supabase_project_ref

# Docker Compose PostgreSQL container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=mcp_sentinel_db
POSTGRES_PORT=5432

# Async connection pool parameters
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10.0
DB_COMMAND_TIMEOUT_SECONDS=15.0

# ==============================================================================
# 3. Real Data Integration: Notion API
# ==============================================================================
# Notion Integration Token (Administrator-configured internal integration token)
# Supports either NOTION_API_KEY or NOTION_API_TOKEN
NOTION_API_KEY=YOUR_NOTION_INTEGRATION_TOKEN
# NOTION_API_TOKEN=YOUR_NOTION_INTEGRATION_TOKEN
# Optional Notion OAuth 2.0 (for user-authorized workspace connections via OAuth authorization flow)
NOTION_CLIENT_ID=YOUR_NOTION_OAUTH_CLIENT_ID
NOTION_CLIENT_SECRET=YOUR_NOTION_OAUTH_CLIENT_SECRET
NOTION_REDIRECT_URI=http://localhost:8000/api/integrations/notion/oauth/callback
# Explicit gate for Notion write capabilities (e.g. archive_page). Default false for read-only connections.
NOTION_WRITE_ENABLED=false

# ==============================================================================
# 4. Security Boundaries & Guardrail Limits
# ==============================================================================
MAX_QUERY_LIMIT=100
DEFAULT_QUERY_LIMIT=50
MAX_AUDIT_NOTE_LENGTH=2000
MAX_REASON_LENGTH=500
APPROVAL_TICKET_TTL_SECONDS=3600
TOOL_TIMEOUT_SECONDS=15.0

# ==============================================================================
# 5. Authentication, Sessions & RBAC/ABAC
# ==============================================================================
# Internal JWT / Session signing key (MUST be at least 32 characters; rotate in production)
SESSION_SECRET=YOUR_STRONG_SESSION_SECRET_MIN_32_CHARACTERS
JWT_SECRET_KEY=YOUR_STRONG_JWT_SECRET_MIN_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
APPROVAL_HMAC_SECRET=YOUR_STRONG_APPROVAL_HMAC_SECRET_MIN_32_CHARACTERS

# Frontend & Backend Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 / OIDC Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Allowed email domains for organizational authentication (comma-separated, e.g. "company.com,partner.org")
ALLOWED_GOOGLE_DOMAINS=

# Set to false in production to enforce real Google OIDC identity token verification
ENABLE_TEST_AUTH=true

# HTTP-Only Session Cookie Security
SESSION_COOKIE_NAME=sentinel_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRATION_HOURS=12

# CSRF header validation on state-changing requests
CSRF_PROTECTION_ENABLED=true

# Explicit CORS allowed origins (comma-separated or JSON list in settings)
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ==============================================================================
# 6. Policy & Risk Engine Configuration
# ==============================================================================
RISK_LOW_MAX=24
RISK_MEDIUM_MAX=49
RISK_HIGH_MAX=74
RISK_CRITICAL_MAX=100
BULK_OPERATION_THRESHOLD=100
CRITICAL_OPERATION_THRESHOLD=1000
DEFAULT_POLICY_ID=sentinel-core-policy
DEFAULT_POLICY_VERSION=1.0.0

# ==============================================================================
# 7. EC2 Production Deployment & Reverse Proxy Configuration
# ==============================================================================
# Domain used for Caddy automatic TLS reverse proxy (--profile tls-proxy)
PRODUCTION_DOMAIN=sentinel.yourdomain.com

# Bind addresses for container ports (127.0.0.1 for security behind reverse proxy)
API_BIND_IP=127.0.0.1
WEB_BIND_IP=127.0.0.1

# Optional container image tag for local builds
IMAGE_TAG=latest

# Optional AWS metadata
AWS_REGION=us-east-1
