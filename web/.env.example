# ==============================================================================
# MCP-Sentinel Web Console - Environment Configuration Example
# ==============================================================================
# Security Notice:
# ONLY public environment variables prefixed with NEXT_PUBLIC_ may be added here.
# NEVER place backend secrets, JWT private keys, or API credentials in this file.
# ==============================================================================

# Server-side Backend Base URL used by Next.js rewrites and SSR (e.g., http://127.0.0.1:8000 or http://api:8000 in Docker)
API_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Client-side exposed API gateway URL (safe for browser exposure)
NEXT_PUBLIC_API_URL=http://localhost:8000
